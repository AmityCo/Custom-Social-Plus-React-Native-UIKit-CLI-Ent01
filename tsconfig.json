{
  "compilerOptions": {
    "paths": {
      "@amityco/react-native-social-uikit-ocean": ["./src/index"],
      // Kept so the example app's existing imports keep resolving after the
      // package rename. Safe to drop once those are migrated.
      "@amityco/react-native-social-uikit": ["./src/index"]
    },
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["esnext"],
    "module": "esnext",
    "moduleResolution": "node",
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitUseStrict": false,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "target": "esnext",
    "noImplicitAny": false,
    "allowSyntheticDefaultImports": true
  }
}
